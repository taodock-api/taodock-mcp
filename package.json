{
  "name": "@taodock-ai/mcp-server",
  "version": "0.2.0",
  "description": "MCP server for TaoDock AI image and video generation.",
  "license": "MIT",
  "author": {
    "name": "TaoDock",
    "url": "https://taodock.com"
  },
  "homepage": "https://github.com/taodock-api/taodock-mcp#readme",
  "mcpName": "io.github.taodock-api/mcp-server",
  "type": "module",
  "bin": {
    "taodock-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/test/config.test.js test-dist/test/media.test.js test-dist/test/models.test.js",
    "validate": "npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "prepack": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run",
    "mcpb": "node build-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "taodock",
    "image-generation",
    "video-generation",
    "ai-tools",
    "claude",
    "cursor",
    "vscode"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taodock-api/taodock-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/taodock-api/taodock-mcp/issues"
  }
}
